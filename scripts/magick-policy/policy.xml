<?xml version="1.0" encoding="UTF-8"?>
<!--
  ImageMagick policy for the studio's image pipeline (scripts/image_pipeline.rb
  sets MAGICK_CONFIGURE_PATH to this folder before any ImageMagick call, so it
  applies to the editor API and generate_thumbnails.rb, not to other uses of
  ImageMagick on this Mac). The pipeline only ever needs JPEG, PNG, GIF, WebP,
  TIFF and BMP, and always names the coder itself ("jpeg:/path[0]"); this is
  the second layer: script-like and network coders, every delegate (external
  programs such as Ghostscript) and "@file" indirection are refused, and the
  resources one image may use are capped.
-->
<!DOCTYPE policymap [
<!ELEMENT policymap (policy)*>
<!ATTLIST policymap xmlns CDATA #FIXED "">
<!ELEMENT policy EMPTY>
<!ATTLIST policy xmlns CDATA #FIXED "" domain NMTOKEN #REQUIRED name NMTOKEN #IMPLIED pattern CDATA #IMPLIED rights NMTOKEN #IMPLIED stealth NMTOKEN #IMPLIED value CDATA #IMPLIED>
]>
<policymap>
  <policy domain="resource" name="width" value="16KP"/>
  <policy domain="resource" name="height" value="16KP"/>
  <policy domain="resource" name="area" value="128MP"/>
  <policy domain="resource" name="memory" value="512MiB"/>
  <policy domain="resource" name="map" value="1GiB"/>
  <policy domain="resource" name="disk" value="1GiB"/>
  <policy domain="resource" name="time" value="60"/>
  <policy domain="coder" rights="none" pattern="{MSL,MVG,SVG,MSVG,RSVG,TEXT,TXT,URL,HTTP,HTTPS,FTP,EPHEMERAL,PS,PS2,PS3,EPS,EPI,EPSF,EPSI,PDF,EPDF,XPS,LABEL,CAPTION,PANGO,INLINE,SHOW,WIN,X,VID}"/>
  <policy domain="delegate" rights="none" pattern="*"/>
  <policy domain="path" rights="none" pattern="@*"/>
</policymap>
