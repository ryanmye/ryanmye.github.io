#!/usr/bin/env bash
# Local development: editor API (port 4001) + Jekyll with drafts (port 4000).
#   bin/dev            then open http://127.0.0.1:4000/editor/
# Ctrl+C stops both. Extra arguments go to `jekyll serve`.
# STUDIO_SITE_PORT=4010 bin/dev serves Jekyll on another port (the API is told
# to accept that origin); STUDIO_API_PORT=4011 runs the API on another port
# (the studio page is built to call it).
set -euo pipefail

cd "$(dirname "$0")/.."
SITE_PORT="${STUDIO_SITE_PORT:-4000}"
API_PORT="${STUDIO_API_PORT:-4001}"
API_LOG=/tmp/studio-editor-api.log
# Extra Jekyll config that tells _layouts/editor.html which API port to call.
PORT_CONFIG="${TMPDIR:-/tmp}/studio-config-$$.yml"
printf 'studio_api_port: %s\n' "$API_PORT" > "$PORT_CONFIG"
API_PID=""
STOPPING="${TMPDIR:-/tmp}/studio-stopping-$$"
cleanup() {
  rm -f "$PORT_CONFIG"
  if [ -n "$API_PID" ] && kill -0 "$API_PID" 2>/dev/null; then
    touch "$STOPPING"   # tells the watcher below this stop is on purpose
    kill "$API_PID" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

# The bundle needs Ruby 3.3; macOS system Ruby 2.6 cannot run it.
if [ -d /opt/homebrew/opt/ruby@3.3/bin ]; then
  export PATH="/opt/homebrew/opt/ruby@3.3/bin:$PATH"
fi

if lsof -ti:"$API_PORT" >/dev/null 2>&1; then
  echo "!! ------------------------------------------------------------------" >&2
  echo "!! Port $API_PORT is already in use. Using whatever is running there as the" >&2
  echo "!! editor API. If that is an old copy of the server, stop it with" >&2
  echo "!!   lsof -ti:$API_PORT | xargs kill" >&2
  echo "!! and run bin/dev again." >&2
  echo "!! ------------------------------------------------------------------" >&2
else
  # `bundle exec ruby` breaks when the repo path contains a space (bundler puts
  # the path in RUBYOPT, which Ruby splits on spaces), so load bundler directly.
  STUDIO_SITE_PORT="$SITE_PORT" STUDIO_API_PORT="$API_PORT" ruby -rbundler/setup scripts/local_editor_server.rb > "$API_LOG" 2>&1 &
  API_PID=$!
  # If the API dies while Jekyll keeps running, say so and show why.
  (
    while kill -0 "$API_PID" 2>/dev/null; do sleep 2; done
    if [ ! -e "$STOPPING" ]; then
      echo >&2
      echo "!! The editor API stopped. Last lines of $API_LOG:" >&2
      tail -n 25 "$API_LOG" >&2
    fi
    rm -f "$STOPPING"
  ) &
  echo "Editor API  http://127.0.0.1:$API_PORT  (log: $API_LOG)"
fi

echo "Studio      http://127.0.0.1:$SITE_PORT/editor/"
echo

# --drafts builds _drafts/ so the studio's Preview works for drafts.
bundle exec jekyll serve --config "_config.yml,$PORT_CONFIG" --livereload --drafts --baseurl "" --host 127.0.0.1 --port "$SITE_PORT" "$@"
